{
  "version": "0.4.0",
  "publisher": "Stevvven",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/szdytom/markview"
  },
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.cjs",
  "icon": "icon.png",
  "scripts": {
    "vscode:prepublish": "node ../build.mjs"
  },
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Markview reads local fonts and launches its packaged exporter."
    }
  },
  "name": "markview-export",
  "displayName": "Markview Integration",
  "description": "Markview font management, Markdown preview and export.",
  "contributes": {
    "commands": [
      {
        "command": "markview.fonts",
        "title": "字体管理…",
        "category": "Markview"
      },
      {
        "command": "markview.preview.open",
        "title": "打开侧边预览",
        "category": "Markview",
        "icon": {
          "light": "media/preview-light.svg",
          "dark": "media/preview-dark.svg"
        }
      },
      {
        "command": "markview.export.pdf",
        "title": "导出 PDF…",
        "category": "Markview"
      },
      {
        "command": "markview.export.png",
        "title": "导出 PNG…",
        "category": "Markview"
      },
      {
        "command": "markview.export.template",
        "title": "使用模板导出…",
        "category": "Markview"
      },
      {
        "command": "markview.preview.template",
        "title": "选择阅读模板…",
        "category": "Markview"
      },
      {
        "command": "markviewExport.exportPdf",
        "title": "导出 PDF…",
        "category": "Markview"
      },
      {
        "command": "markviewExport.exportPng",
        "title": "导出 PNG…",
        "category": "Markview"
      },
      {
        "command": "markviewExport.exportWithTemplate",
        "title": "使用模板导出…",
        "category": "Markview"
      },
      {
        "command": "markview.exportPdf",
        "title": "导出 PDF…",
        "category": "Markview"
      },
      {
        "command": "markview.exportPng",
        "title": "导出 PNG…",
        "category": "Markview"
      },
      {
        "command": "markview.exportWithTemplate",
        "title": "使用模板导出…",
        "category": "Markview"
      },
      {
        "command": "markview.openPreview",
        "title": "打开侧边预览",
        "category": "Markview"
      }
    ],
    "configuration": {
      "title": "Markview Integration",
      "properties": {
        "markview.fontDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional local font directories."
        },
        "markview.previewStyleFile": {
          "type": "string",
          "default": "",
          "description": "Custom MVSS reading stylesheet. In directory settings, relative paths resolve from the directory containing .vscode. Use an absolute path in user settings.",
          "scope": "resource"
        },
        "markview.exportTemplate": {
          "type": "string",
          "default": "default",
          "description": "Default export template ID.",
          "scope": "resource"
        },
        "markview.exportFontSize": {
          "type": "number",
          "default": 16,
          "minimum": 1,
          "description": "Export font size in pixels."
        },
        "markview.exportScale": {
          "type": "number",
          "default": 2,
          "minimum": 0.1,
          "description": "PNG output scale."
        },
        "markview.previewTemplate": {
          "type": "string",
          "enum": [
            "default",
            "light",
            "dark",
            "celadon",
            "blueprint",
            "rosewood",
            "8-bit"
          ],
          "default": "default",
          "description": "Bundled reading template. Default follows the VS Code theme; previewStyleFile takes precedence.",
          "scope": "resource"
        },
        "markview.fontSize": {
          "type": "number",
          "default": 18,
          "minimum": 1,
          "maximum": 200,
          "description": "Reading font size in pixels.",
          "scope": "language-overridable"
        },
        "markview.width": {
          "type": "number",
          "default": 760,
          "minimum": 100,
          "maximum": 8192,
          "description": "Maximum reading column width in pixels.",
          "scope": "language-overridable"
        },
        "markview.justify": {
          "type": "boolean",
          "default": true,
          "description": "Justify reading paragraphs.",
          "scope": "language-overridable"
        },
        "markview.hyphenate": {
          "type": "boolean",
          "default": true,
          "description": "Hyphenate words at line breaks.",
          "scope": "language-overridable"
        },
        "markview.paragraphIndent": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 10,
          "description": "First-line reading paragraph indent in em.",
          "scope": "language-overridable"
        },
        "markview.codeWrap": {
          "type": "boolean",
          "default": false,
          "description": "Wrap long code-block lines in the preview.",
          "scope": "language-overridable"
        },
        "markview.exportStyleFile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Custom MVSS export stylesheet. In directory settings, relative paths resolve from the directory containing .vscode. Takes precedence over exportTemplate. Use an absolute path in user settings."
        },
        "markview.template": {
          "type": "string",
          "default": "",
          "scope": "language-overridable",
          "description": "Compatibility with earlier Markview releases.",
          "deprecationMessage": "Use markview.previewTemplate / exportTemplate. Explicit new settings take precedence."
        },
        "markviewExport.template": {
          "type": "string",
          "default": "",
          "scope": "language-overridable",
          "description": "Compatibility with earlier Markview releases.",
          "deprecationMessage": "Use markview.exportTemplate. Explicit new settings take precedence."
        },
        "markview.columnWidth": {
          "type": "number",
          "default": 760,
          "scope": "language-overridable",
          "description": "Compatibility with earlier Markview releases.",
          "deprecationMessage": "Use markview.width. Explicit new settings take precedence."
        },
        "markview.codeblockWrap": {
          "type": "boolean",
          "default": false,
          "scope": "language-overridable",
          "description": "Compatibility with earlier Markview releases.",
          "deprecationMessage": "Use markview.codeWrap. Explicit new settings take precedence."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "markview.preview.open",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "markview.export.pdf",
          "when": "editorLangId == markdown",
          "group": "markview"
        },
        {
          "command": "markview.export.png",
          "when": "editorLangId == markdown",
          "group": "markview"
        },
        {
          "command": "markview.export.template",
          "when": "editorLangId == markdown",
          "group": "markview"
        }
      ],
      "commandPalette": [
        {
          "command": "markviewExport.exportPdf",
          "when": "false"
        },
        {
          "command": "markviewExport.exportPng",
          "when": "false"
        },
        {
          "command": "markviewExport.exportWithTemplate",
          "when": "false"
        },
        {
          "command": "markview.exportPdf",
          "when": "false"
        },
        {
          "command": "markview.exportPng",
          "when": "false"
        },
        {
          "command": "markview.exportWithTemplate",
          "when": "false"
        },
        {
          "command": "markview.openPreview",
          "when": "false"
        }
      ]
    }
  },
  "activationEvents": [
    "onWebviewPanel:markview.preview"
  ]
}
